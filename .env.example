# Copy to .env next to compose.yaml. Two readers share this one file:
#   - docker compose, for the ${...} substitutions in compose.yaml (CAD_PORT, CAD_IMAGE_TAG, CAD_UID, CAD_GID, TZ)
#   - the app, via Dotenv.load in app.rb (everything else; compose bind-mounts the file read-only at /app/.env)
# The CLI (bin/cad-render) reads its variables from the shell environment, not from this file.
# Keep it 0600: it holds the Zoo token.

# --- service ------------------------------------------------------------------------------------
# Zoo (zoo.dev) API token for text-to-CAD. Optional: /zoo is disabled without it (health reports zoo_token=false).
ZOO_API_TOKEN=
# Hard timeout per job (s); the worker process group is killed and the request gets 504.
#CAD_TIMEOUT_S=300
# Concurrent worker subprocesses; requests beyond CAD_MAX_JOBS wait in a queue of CAD_MAX_QUEUE, then 503.
#CAD_MAX_JOBS=2
#CAD_MAX_QUEUE=8
# Upload caps: tarball/file size (MiB) and files per project tarball.
#CAD_MAX_UPLOAD_MB=100
#CAD_MAX_FILES=2000
# Zoo: websocket ping interval (s), overall text-to-CAD timeout (s), API base URL.
#ZOO_POLL_S=5
#ZOO_TIMEOUT_S=600
#ZOO_API_URL=https://api.zoo.dev
# Python interpreter used for the workers.
#CAD_PYTHON=python3

# --- compose (read by docker compose only) -----------------------------------------------------
# Host port published for the service.
# Tag of the prebuilt image ghcr.io/rojosinalma/cad-render (pin a version instead of latest).
#CAD_IMAGE_TAG=latest
#CAD_PORT=9292
# uid/gid the container runs as: use the owner of .env so the 0600 file is readable in the container.
#CAD_UID=1000
#CAD_GID=1000
#TZ=UTC

# --- CLI (bin/cad-render; export these in your shell) -------------------------------------------
# Service URL and curl timeout (s).
#CAD_RENDER_URL=http://localhost:9292
#CAD_RENDER_TIMEOUT=900
# Bambuddy, both required for --to-bb.
#BAMBUDDY_URL=
#BAMBUDDY_API_KEY=
